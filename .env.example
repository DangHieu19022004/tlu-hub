# API Configuration
# Backend API Base URL
# Development: http://localhost:5178
# Production: https://tailieutlu-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://tailieutlu-backend.onrender.com

# Application Settings
# Development: development
# Production: production
NODE_ENV=development

# Optional: API Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# Optional: Enable API request/response logging
NEXT_PUBLIC_API_DEBUG=true
